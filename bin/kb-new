#!/usr/bin/env python3
"""kb-new — создание заметки из шаблона с корректной YAML-шапкой и именем.

Профилактика вместо проверки: половина ошибок формата просто не возникает.

Использование:
  kb-new TYPE "Заголовок" [--tags a,b] [--author X] [--source S] [--dir D] [--dry-run] [--json]

TYPE: note | decision | episode | skill | person | review
Папка по умолчанию: note,decision → reference/; episode → journal/;
skill → skills/; person → reference/hubs/; review → inbox/telegram/
(разбор из канала Telegram, ждёт одобрения владельца).
Exit code: 0 — создано, 1 — ошибка.
"""
import argparse, json, os, re, sys, unicodedata
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"))
import kbcore as K

DEST = {"note": "reference", "decision": "reference", "episode": "journal",
        "skill": "skills", "person": "reference/hubs", "review": "inbox/telegram"}

TRANSLIT = dict(zip(
    "абвгдеёжзийклмнопрстуфхцчшщъыьэюяіїєґ",
    ["a","b","v","g","d","e","e","zh","z","i","y","k","l","m","n","o","p","r","s","t",
     "u","f","h","ts","ch","sh","sch","","y","","e","yu","ya","i","yi","ye","g"]))


def slugify(title):
    s = title.lower()
    s = "".join(TRANSLIT.get(ch, ch) for ch in s)
    s = unicodedata.normalize("NFKD", s).encode("ascii", "ignore").decode()
    s = re.sub(r"[^a-z0-9]+", "-", s).strip("-")
    return s or "zametka"


def default_author(root):
    """Автор по умолчанию: $KB_AUTHOR > author из <база>/.kb.toml > "owner"."""
    env = os.environ.get("KB_AUTHOR")
    if env:
        return env
    return (K.read_config(root).get("author") if root else None) or "owner"


def main():
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("type", choices=sorted(DEST))
    p.add_argument("title")
    p.add_argument("--tags", default="", help="через запятую")
    p.add_argument("--author", help="по умолчанию: $KB_AUTHOR или author из .kb.toml базы")
    p.add_argument("--source", default="ручное создание")
    p.add_argument("--basis", choices=sorted(K.VALID_BASIS), help="на чём основано содержание")
    p.add_argument("--dir", help="папка назначения относительно корня (переопределяет тип)")
    p.add_argument("--root")
    p.add_argument("--dry-run", action="store_true")
    p.add_argument("--json", action="store_true")
    a = p.parse_args()

    root = os.path.abspath(a.root) if a.root else K.find_root()
    if not root:
        print("kb-new: корень базы не найден (задайте KB_ROOT или --root)", file=sys.stderr)
        sys.exit(1)
    if not a.author:
        a.author = default_author(root)

    date = K.today()
    slug = slugify(a.title)
    rel_dir = a.dir or DEST[a.type]
    fname = ("%s-%s.md" % (date, slug)) if a.type == "episode" else ("%s.md" % slug)
    rel = os.path.join(rel_dir, fname).replace("\\", "/")
    ap = os.path.join(root, rel)
    i = 2
    while os.path.exists(ap):
        stem = fname[:-3]
        ap = os.path.join(root, rel_dir, "%s-%d.md" % (stem, i))
        rel = os.path.relpath(ap, root).replace("\\", "/")
        i += 1

    tpl_path = os.path.join(root, "templates", "%s.md" % a.type)
    if os.path.isfile(tpl_path):
        body = open(tpl_path, encoding="utf-8").read()
    else:
        body = "---\ncreated: {{date}}\nsource:\nauthor:\ntags: []\nstatus: active\n---\n# {{title}}\n"
    tags = "[%s]" % ", ".join(t.strip() for t in a.tags.split(",") if t.strip())
    body = (body.replace("{{date}}", date)
                .replace("{{title}}", a.title)
                .replace("{{Имя Фамилия}}", a.title))
    # заполняем поля шапки
    body = re.sub(r"(?m)^created:.*$", "created: %s" % date, body, count=1)
    body = re.sub(r"(?m)^source:.*$", "source: %s" % a.source, body, count=1)
    body = re.sub(r"(?m)^author:.*$", "author: %s" % a.author, body, count=1)
    if a.tags:
        body = re.sub(r"(?m)^tags:.*$", "tags: %s" % tags, body, count=1)
    if a.basis:
        body = re.sub(r"(?m)^(status:.*)$", r"\1" + "\nbasis: %s" % a.basis, body, count=1)

    if a.dry_run:
        out = {"would_create": rel, "root": root}
    else:
        os.makedirs(os.path.dirname(ap), exist_ok=True)
        with open(ap, "w", encoding="utf-8") as f:
            f.write(body)
        out = {"created": rel, "root": root}
    if a.json:
        print(json.dumps(out, ensure_ascii=False))
    else:
        verb = "создал бы (dry-run)" if a.dry_run else "создано:"
        print("kb-new %s %s" % (verb, rel))
        if not a.dry_run:
            print("напоминание: добавьте [[ссылки]] на хаб и смежные заметки, затем kb-lint --file %s" % rel)


if __name__ == "__main__":
    main()
